# Boardless RISC-V smoke build products.
/software/efinity_smoke/build/

# Efinity board projects are generated locally after the exact board package is
# known.  Keep source notes, but never retain large work/output databases or
# simulator trees in this repository.
/efinity/*/work*/
/efinity/*/outflow/
/efinity/*/output/
/efinity/*/sim*/
/efinity/*/.metadata/
/efinity/*/*.bit
/efinity/*/*.hex
/efinity/*/*.bin
